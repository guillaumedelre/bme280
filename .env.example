# I2C configuration
BME280_I2C_BUS=1
BME280_I2C_ADDRESS=0x77
# IIR filter coefficient: 0=off 1=2x 2=4x 3=8x 4=16x (recommended: 2 for indoor use)
BME280_IIR_FILTER=0

# MQTT broker
MQTT_BROKER_HOST=192.168.1.x
MQTT_USERNAME=homeassistant
MQTT_PASSWORD=
MQTT_CLIENT_ID=rpi-bme280

# Flask
FLASK_PORT=5000
FLASK_DEBUG=false
